

def leer_numeros_enteros() ->int:
    num_valido = False
    while num_valido:
        entrada = input("ingrese valor mayor que cero: ")
        try:
            numero_a_revisar = int(entrada)
        
            if numero_a_revisar > 0:
                num_valido = True
            else:
                print("entrada no válida")
        except:
            print("entrada no válida")
    return numero_a_revisar
    
numero = leer_numeros_enteros()
